# Copy to .env and set your local database connection. Never commit .env.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/mahindra_i2p

# One-time password links are emailed when SMTP is configured. They are also
# returned to the administrator for manual sharing if SMTP is unavailable.
# LAN demo: replace 192.168.1.10 with this computer's current LAN IPv4 address.
# Recipients must be able to reach the computer over LAN or VPN.
FRONTEND_URL=http://192.168.1.10:5173
# Production: use the deployed public HTTPS address instead:
# FRONTEND_URL=https://your-portal.company.com

# SMTP settings (587 + STARTTLS is typical; set SMTP_USE_TLS=false for a relay
# that does not use STARTTLS). EMAIL_FROM defaults to SMTP_USER.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
EMAIL_FROM=tracker@example.com
EMAIL_FROM_NAME=Invoice to Payment Tracker

# Invoice data source: "file" reads backend/data/*.xlsx|csv, "api" reads the BigQuery query API.
INVOICE_SOURCE=file
BIGQUERY_API_URL=https://bigqueryapi.m-devsecops.com
BIGQUERY_API_TOKEN=your-bearer-token
# Optional tuning: rows per request, seconds per request, parallel requests.
# BIGQUERY_PAGE_SIZE=10000
# BIGQUERY_TIMEOUT=120
# BIGQUERY_WORKERS=4
# How often to fetch fresh invoices from BigQuery in the background (minutes; 0 = only after each start).
# INVOICE_REFRESH_MINUTES=60
