# Copy to .env and set your local database connection. Never commit .env.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/mahindra_i2p

# REQUIRED. Signs every login token; the app refuses to start without it. Use a different
# random value per environment and never commit it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Browser origins allowed to call the API cross-origin (comma separated). FRONTEND_URL below is
# always allowed; this is only for extras. Never use *.
# CORS_ORIGINS=https://portal.example.com

# How long a sign-in lasts, in minutes (default 480 = 8 hours; allowed 5-1440).
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# Sign-in attempts allowed per caller address per 5 minutes, across all accounts (default 30).
# Each account also locks for 15 minutes after 5 wrong passwords.
# LOGIN_ATTEMPTS_PER_IP=30
# Interactive API docs (/docs, /redoc, /openapi.json). Off unless set; enable on developer
# machines only, never on a deployed server.
# ENABLE_API_DOCS=true

# One-time password links are emailed when SMTP is configured. They are also
# returned to the administrator for manual sharing if SMTP is unavailable.
# LAN demo: replace 192.168.1.10 with this computer's current LAN IPv4 address.
# Recipients must be able to reach the computer over LAN or VPN.
FRONTEND_URL=http://192.168.1.10:5173
# Production: use the deployed public HTTPS address instead:
# FRONTEND_URL=https://your-portal.company.com

# SMTP settings (587 + STARTTLS is typical; set SMTP_USE_TLS=false for a relay
# that does not use STARTTLS). EMAIL_FROM defaults to SMTP_USER.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
EMAIL_FROM=tracker@example.com
EMAIL_FROM_NAME=Invoice to Payment Tracker

# Invoice data source: "file" reads backend/data/*.xlsx|csv, "api" reads the BigQuery query API.
INVOICE_SOURCE=file
BIGQUERY_API_URL=https://bigqueryapi.m-devsecops.com
BIGQUERY_API_TOKEN=your-bearer-token
# Optional tuning: rows per request, seconds per request, parallel requests.
# BIGQUERY_PAGE_SIZE=10000
# BIGQUERY_TIMEOUT=120
# BIGQUERY_WORKERS=4
# --- Automatic invoice sync (the schedule is set by the team that owns the BigQuery tables) ---
# Either fixed daily times (e.g. shortly after the warehouse loads); when set, the interval is ignored:
# INVOICE_SYNC_TIMES=06:30,14:30
# Time zone for those times; default is the server's own. Use +05:30 for IST on a UTC server:
# INVOICE_SYNC_UTC_OFFSET=+05:30
# ...or every N minutes (default 60; 0 = only once, at start-up):
# INVOICE_REFRESH_MINUTES=60
# After a failed sync, retry after this many minutes, doubling each time (default 5: 5, 10, 20 ...):
# INVOICE_SYNC_RETRY_MINUTES=5
# Data older than this is reported as stale ("degraded" in /health/ready, amber label in the app).
# Default: 26 hours with daily times, otherwise 3 x the interval (at least 3 hours).
# INVOICE_STALE_AFTER_MINUTES=180
