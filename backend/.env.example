# Copy this file to .env (gitignored — one per machine, never commit it) and fill in your
# own values. This is read automatically on startup (see app/core/database.py).

# Omit this entirely to use a local SQLite file instead (no database server needed):
#   DATABASE_URL=sqlite:///./data/app.db
#
# For MySQL, URL-encode any special characters in the password: @ -> %40, : -> %3A, / -> %2F
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/mahindra_i2p
