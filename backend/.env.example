# Copy to .env and set your local database connection. Never commit .env.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/mahindra_i2p

# REQUIRED. Signs every login token; the app refuses to start without it. Use a different
# random value per environment and never commit it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Browser origins allowed to call the API cross-origin (comma separated). FRONTEND_URL below is
# always allowed; this is only for extras. Never use *.
# CORS_ORIGINS=https://portal.example.com

# How long a sign-in lasts, in minutes (default 480 = 8 hours; allowed 5-1440).
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# Sign-in attempts allowed per caller address per 5 minutes, across all accounts (default 30).
# Each account also locks for 15 minutes after 5 wrong passwords.
# LOGIN_ATTEMPTS_PER_IP=30
# Interactive API docs (/docs, /redoc, /openapi.json). Off unless set; enable on developer
# machines only, never on a deployed server.
# ENABLE_API_DOCS=true

# One-time password links are emailed when SMTP is configured. They are also
# returned to the administrator for manual sharing if SMTP is unavailable.
# LAN demo: replace 192.168.1.10 with this computer's current LAN IPv4 address.
# Recipients must be able to reach the computer over LAN or VPN.
FRONTEND_URL=http://192.168.1.10:5173
# Production: use the deployed public HTTPS address instead:
# FRONTEND_URL=https://your-portal.company.com

# SMTP settings (587 + STARTTLS is typical; set SMTP_USE_TLS=false for a relay
# that does not use STARTTLS). EMAIL_FROM defaults to SMTP_USER.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
EMAIL_FROM=tracker@example.com
EMAIL_FROM_NAME=MPayVision

# Invoice data source: "file" reads backend/data/*.xlsx|csv, "api" reads the BigQuery query API.
INVOICE_SOURCE=file
BIGQUERY_API_URL=https://bigqueryapi.m-devsecops.com
BIGQUERY_API_TOKEN=your-bearer-token
# Optional tuning: rows per request, seconds per request, parallel requests.
# BIGQUERY_PAGE_SIZE=10000
# BIGQUERY_TIMEOUT=120
# BIGQUERY_WORKERS=4
# Audit log: keep entries for this many days (default 365, minimum 30); older ones are removed daily.
# AUDIT_RETENTION_DAYS=365
# Supplier passwords expire after this many days (0 = never); a reminder email goes out
# SUPPLIER_PASSWORD_REMINDER_DAYS before, and a reset link when it expires.
# SUPPLIER_PASSWORD_MAX_AGE_DAYS=90
# SUPPLIER_PASSWORD_REMINDER_DAYS=5
# Where saved invoice data (the BigQuery snapshot) and ticket attachments are kept. Default: backend/data/.
# On Cloud Run point both at the mounted Cloud Storage bucket (see docs/deployment.md):
# INVOICE_CACHE_DIR=/mnt/i2p-data/invoice-cache
# TICKET_ATTACHMENT_DIR=/mnt/i2p-data/attachments

# --- Automatic invoice sync (the schedule is set by the team that owns the BigQuery tables) ---
# Master switch. Off (default): the backend never calls BigQuery by itself; the saved snapshot is
# served and data changes only when an admin presses "Sync now" (a server with no snapshot loads
# once, to have any data). Turn on only once the GCP team approves automatic use of the API;
# everything below applies only when it is on.
INVOICE_AUTO_SYNC=false
# Either fixed daily times (e.g. shortly after the warehouse loads); when set, the interval is ignored:
# INVOICE_SYNC_TIMES=06:30,14:30
# Time zone for those times; default is the server's own. Use +05:30 for IST on a UTC server:
# INVOICE_SYNC_UTC_OFFSET=+05:30
# ...or every N minutes (default 60; 0 = only once, at start-up):
# INVOICE_REFRESH_MINUTES=60
# After a failed sync, retry after this many minutes, doubling each time (default 5: 5, 10, 20 ...):
# INVOICE_SYNC_RETRY_MINUTES=5
# Data older than this is reported as stale ("degraded" in /health/ready, amber label in the app).
# Default: 26 hours with daily times, otherwise 3 x the interval (at least 3 hours).
# INVOICE_STALE_AFTER_MINUTES=180

# --- Single sign-on for staff (Mahindra CC Services). Off unless SSO_ENABLED=true. ---
# Our own app ID / callback / key per environment come from the CC Services team; until then a
# developer may test locally with another registered app's values (never commit them).
# SSO_ENABLED=false
# Login page of CC Services, with our app id and environment (DEV / UAT / PROD):
# SSO_LOGIN_URL=https://ccservices.example.com/auth/login?id=YOUR_APP_ID&env=DEV
# Path CC Services redirects back to (must match the registered callback URL). Default:
# SSO_CALLBACK_PATH=/api/v1/auth/sso/callback
# Parameter(s) that carry the token (default: token, ssoToken, data, encData, accessToken, ...);
# parameter for our state, if CC returns one:
# SSO_TOKEN_PARAM=token
# SSO_STATE_PARAM=
# Legacy CC Services tokens: AES-ECB/PKCS#7, encrypted but NOT signed. Must be enabled explicitly.
# SSO_CC_SERVICES_LEGACY_ENABLED=true
# SSO_TOKEN_DECRYPT_SECRET=
# How the key above is written: utf8 (default), base64 or hex. It must give 16, 24 or 32 bytes.
# SSO_TOKEN_KEY_ENCODING=utf8
# Refuse tokens whose time is older than this many seconds (default 120):
# SSO_TOKEN_MAX_AGE_SECONDS=120
# Field names in the decrypted token (comma separated, first found wins); defaults cover the usual names:
# SSO_EMPLOYEE_ID_FIELDS=employeeId,empId,tokenNo
# SSO_EMAIL_FIELDS=email,emailId
# SSO_TIME_FIELDS=timestamp,iat
# lax (default) when CC Services redirects back with GET; none (HTTPS only) if it POSTs a form:
# SSO_COOKIE_SAMESITE=lax
# After sign-in the browser is sent to FRONTEND_URL/sso/callback.
