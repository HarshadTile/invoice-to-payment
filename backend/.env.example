# Copy this file to .env (gitignored — one per machine, never commit it) and fill in your
# own values. This is read automatically on startup (see app/core/database.py).

# Omit this entirely to use a local SQLite file instead (no database server needed):
#   DATABASE_URL=sqlite:///./data/app.db
#
# For MySQL, URL-encode any special characters in the password: @ -> %40, : -> %3A, / -> %2F
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/mahindra_i2p

# Required for "Forgot password" to actually send an email (see app/core/email.py). Without
# these, requesting a reset still works and the link is printed to the console instead.
# For Gmail: SMTP_PASSWORD is an "app password" (Google Account > Security > App passwords),
# not your regular login password — Gmail rejects the real one for SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@example.com
SMTP_USE_TLS=true

# Base URL of the running frontend — used to build the link inside reset-password emails.
FRONTEND_URL=http://localhost:5173

# Optional passwordless supplier authentication. Defaults to vendor-code-only login.
SUPPLIER_MOBILE_AUTH=false
# Required for OTP mode: independent, randomly generated secrets (at least 32 characters).
JWT_SECRET_KEY=
SUPPLIER_OTP_SECRET=
# Mock SMS is allowed ONLY when both settings below are explicitly configured.
APP_ENV=production
SUPPLIER_SMS_MODE=disabled
# For real SMS, use SUPPLIER_SMS_MODE=2factor and an approved OTP template name.
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=SupplierLoginOTP
# Invoice source (default shown); mobile mappings belong in the separate file below.
# SUPPLIER_INVOICE_EXCEL_FILE=data/gcp_invoice_data.xlsx
# Preferred: separate private mobile master, sheet vendors, one row per SUPPLIER.
# When configured, OTP uses this file exclusively; invoice mobile cells are ignored.
# SUPPLIER_MOBILE_EXCEL_FILE=data/local-supplier-mobiles.xlsx
