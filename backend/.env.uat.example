# UAT settings (the environment the VAPT and business teams test). Copy to .env.uat (gitignored) and
# fill in the blanks, then start the backend with APP_ENV=uat. On Cloud Run, set these as service
# variables instead (passwords from Secret Manager); real variables always win over the file.
# Never commit a filled-in copy.

# --- Secrets (from Secret Manager on Cloud Run) ---
DATABASE_URL=mysql+pymysql://<user>:<password>@<uat-cloud-sql-private-ip>:3306/mahindra_i2p
JWT_SECRET_KEY=
BIGQUERY_API_TOKEN=
SMTP_PASSWORD=

# --- Address of this environment (email links, allowed browser origin) ---
FRONTEND_URL=https://<uat-address>

# --- Email: company SMTP for UAT (ask IT for host, port and the sender mailbox) ---
SMTP_HOST=<uat-smtp-host>
SMTP_PORT=587
SMTP_USER=<uat-smtp-user>
SMTP_USE_TLS=true
EMAIL_FROM=<uat-sender@company-domain>
EMAIL_FROM_NAME=Invoice to Payment Tracker (UAT)

# --- Invoice data (BigQuery): daily at 8:00 am IST, approved by the GCP team (their load runs 6-7 am) ---
INVOICE_SOURCE=api
BIGQUERY_API_URL=https://bigqueryapi.m-devsecops.com
INVOICE_AUTO_SYNC=true
INVOICE_SYNC_TIMES=08:00
INVOICE_SYNC_UTC_OFFSET=+05:30

# --- Files that must survive restarts (mounted bucket on Cloud Run) ---
INVOICE_CACHE_DIR=/mnt/i2p-data/invoice-cache
TICKET_ATTACHMENT_DIR=/mnt/i2p-data/attachments

# --- Security: interactive API docs stay off (do not set ENABLE_API_DOCS) ---
AUDIT_RETENTION_DAYS=365
