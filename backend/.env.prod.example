# PRODUCTION settings. Copy to .env.prod (gitignored) and fill in the blanks, then start the backend
# with APP_ENV=prod. On Cloud Run, set these as service variables instead (passwords from Secret
# Manager); real variables always win over the file. Never commit a filled-in copy, and use a
# different JWT_SECRET_KEY and database password from UAT.

# --- Secrets (from Secret Manager on Cloud Run) ---
DATABASE_URL=mysql+pymysql://<user>:<password>@<prod-cloud-sql-private-ip>:3306/mahindra_i2p
JWT_SECRET_KEY=
BIGQUERY_API_TOKEN=
SMTP_PASSWORD=

# --- Address of this environment (email links, allowed browser origin) ---
FRONTEND_URL=https://<production-address>

# --- Email: company SMTP for Production (ask IT for host, port and the sender mailbox) ---
SMTP_HOST=<prod-smtp-host>
SMTP_PORT=587
SMTP_USER=<prod-smtp-user>
SMTP_USE_TLS=true
EMAIL_FROM=<sender@company-domain>
EMAIL_FROM_NAME=Invoice to Payment Tracker

# --- Invoice data (BigQuery): daily at 8:00 am IST, approved by the GCP team (their load runs 6-7 am) ---
INVOICE_SOURCE=api
BIGQUERY_API_URL=https://bigqueryapi.m-devsecops.com
INVOICE_AUTO_SYNC=true
INVOICE_SYNC_TIMES=08:00
INVOICE_SYNC_UTC_OFFSET=+05:30

# --- Files that must survive restarts (mounted bucket on Cloud Run) ---
INVOICE_CACHE_DIR=/mnt/i2p-data/invoice-cache
TICKET_ATTACHMENT_DIR=/mnt/i2p-data/attachments

# --- Security: interactive API docs stay off (do not set ENABLE_API_DOCS) ---
AUDIT_RETENTION_DAYS=365

# --- Single sign-on for staff (Mahindra CC Services). Off unless SSO_ENABLED=true. ---
# Our own app ID / callback / key per environment come from the CC Services team; until then a
# developer may test locally with another registered app's values (never commit them).
# SSO_ENABLED=false
# Login page of CC Services, with our app id and environment (DEV / UAT / PROD):
# SSO_LOGIN_URL=https://ccservices.example.com/auth/login?id=YOUR_APP_ID&env=DEV
# Path CC Services redirects back to (must match the registered callback URL). Default:
# SSO_CALLBACK_PATH=/api/v1/auth/sso/callback
# Parameter(s) that carry the token (default: token, ssoToken, data, encData, accessToken, ...);
# parameter for our state, if CC returns one:
# SSO_TOKEN_PARAM=token
# SSO_STATE_PARAM=
# Legacy CC Services tokens: AES-ECB/PKCS#7, encrypted but NOT signed. Must be enabled explicitly.
# SSO_CC_SERVICES_LEGACY_ENABLED=true
# SSO_TOKEN_DECRYPT_SECRET=
# How the key above is written: utf8 (default), base64 or hex. It must give 16, 24 or 32 bytes.
# SSO_TOKEN_KEY_ENCODING=utf8
# Refuse tokens whose time is older than this many seconds (default 120):
# SSO_TOKEN_MAX_AGE_SECONDS=120
# Field names in the decrypted token (comma separated, first found wins); defaults cover the usual names:
# SSO_EMPLOYEE_ID_FIELDS=employeeId,empId,tokenNo
# SSO_EMAIL_FIELDS=email,emailId
# SSO_TIME_FIELDS=timestamp,iat
# lax (default) when CC Services redirects back with GET; none (HTTPS only) if it POSTs a form:
# SSO_COOKIE_SAMESITE=lax
# After sign-in the browser is sent to FRONTEND_URL/sso/callback.
