# Copy this file to .env.local (gitignored — one per machine) and adjust as needed.
# Vite only reads variables prefixed with VITE_.

# Required for the app to show real data. Without it, invoices, the dashboard
# and search all try to call a different, unrelated Express server (see the
# "Getting started" section of README.md) instead of the FastAPI backend in
# ../backend, and will render blank.
VITE_USE_FASTAPI_INVOICES=true

# Skips the login screen entirely (auto-authenticated as Admin / HQ) — useful
# for quick local UI work, but never enable this for anything other users
# might see. Leave unset/false normally.
# VITE_DISABLE_AUTH=false
